# name: test/sql/search.test
# description: yf.search — bind-time typed schema (network-free) + live lookup invariants.
# group: [sql]

require-env VGI_TEST_WORKER

# HTTP errors must fail the suite instead of silently skipping the test.
set ignore_error_messages

# The HTTP transport (VGI_TEST_WORKER = a URL, e.g. the Cloudflare Worker) rides httpfs;
# harmless for the stdio worker. An explicit LOAD, not `require httpfs`: the haybarn
# runner's `require` only sees statically linked extensions and would skip the file.
statement ok
LOAD httpfs;

statement ok
ATTACH 'yfinance' AS yf (TYPE vgi, LOCATION '{VGI_TEST_WORKER}');

statement ok
SET search_path='yf.main';

# --- Schema (DESCRIBE binds only; no network). ---

query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM yf.search('apple'));
----
symbol,short_name,long_name,exchange,quote_type,type_disp,score

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM yf.search('apple')) WHERE column_name = 'score';
----
DOUBLE

# --- Live invariants (hits Yahoo). ---

# Searching for "apple" surfaces the AAPL ticker.
query I
SELECT (count(*) FILTER (WHERE symbol = 'AAPL') > 0)::INT FROM yf.search('apple');
----
1

# The count arg bounds (and does not zero out) the result set.
query I
SELECT (count(*) BETWEEN 1 AND 5)::INT FROM yf.search('vanguard', count := 5);
----
1

# --- LATERAL: `query` is a per-row input column (blended row-transform). ---

# The best match for each outer row, stamped onto the right row; `count` stays a literal
# named arg alongside the column; a NULL row contributes no rows.
query TT
SELECT c.name, s.symbol
FROM (VALUES ('apple'), ('microsoft'), (NULL)) c(name),
     LATERAL yf.search(c.name, count := 1) s
ORDER BY c.name;
----
apple	AAPL
microsoft	MSFT

# Regression: count := 0 used to fall back to the default 8; it now clamps to 1.
query I
SELECT count(*) FROM yf.search('apple', count := 0);
----
1

# --- Composition: search output feeds quote and history via chained LATERAL. ---

query TTI
WITH pick AS (
  SELECT c.name, s.symbol
  FROM (VALUES ('apple'), ('microsoft')) c(name), LATERAL yf.search(c.name, count := 5) s
  WHERE s.quote_type = 'EQUITY'
  QUALIFY row_number() OVER (PARTITION BY c.name ORDER BY s.score DESC) = 1)
SELECT p.name, p.symbol, (count(*) > 0 AND bool_and(h.adjclose > 0) AND min(q.regular_market_price) > 0)::INT
FROM pick p, LATERAL yf.quote(p.symbol) q, LATERAL yf.history(p.symbol, range := '5d') h
GROUP BY p.name, p.symbol ORDER BY p.name;
----
apple	AAPL	1
microsoft	MSFT	1
