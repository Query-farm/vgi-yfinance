# name: test/sql/quote.test
# description: yf.quote — bind-time typed schema (network-free) + live snapshot invariants.
# group: [sql]

require-env VGI_TEST_WORKER

# The HTTP transport (VGI_TEST_WORKER = a URL, e.g. the Cloudflare Worker) rides httpfs;
# harmless for the stdio worker. An explicit LOAD, not `require httpfs`: the haybarn
# runner's `require` only sees statically linked extensions and would skip the file.
statement ok
LOAD httpfs;

statement ok
ATTACH 'yfinance' AS yf (TYPE vgi, LOCATION '${VGI_TEST_WORKER}');

statement ok
SET search_path='yf.main';

# --- Schema (DESCRIBE binds only; no network). ---

query T
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM yf.quote('AAPL'));
----
symbol,short_name,long_name,currency,exchange,quote_type,regular_market_price,regular_market_change,regular_market_change_percent,regular_market_volume,regular_market_day_high,regular_market_day_low,regular_market_previous_close,fifty_two_week_high,fifty_two_week_low,regular_market_time

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM yf.quote('AAPL')) WHERE column_name = 'regular_market_price';
----
DOUBLE

query T
SELECT column_type FROM (DESCRIBE SELECT * FROM yf.quote('AAPL')) WHERE column_name = 'regular_market_time';
----
TIMESTAMP WITH TIME ZONE

# --- Live invariants (hits Yahoo). ---

# A single symbol snapshot carries a positive price.
query I
SELECT (regular_market_price > 0)::INT FROM yf.quote('AAPL');
----
1

# The parallel fan-out returns one row per requested megacap symbol.
query I
SELECT (count(*) > 0)::INT FROM yf.quote('AAPL,MSFT,GOOG');
----
1

# The requested symbol is echoed back on the row.
query I
SELECT (count(*) FILTER (WHERE symbol = 'AAPL') > 0)::INT FROM yf.quote('AAPL,MSFT');
----
1

# --- LATERAL: `symbols` is a per-row input column (blended row-transform). ---

# One quote per outer row, stamped onto the right outer row; a NULL row and an
# unresolvable ticker contribute no rows; a duplicate outer row gets its own copy.
query IT
SELECT count(*), string_agg(t.note || '=' || q.symbol, ',' ORDER BY t.note)
FROM (VALUES ('AAPL', 'a'), ('MSFT', 'm'), (NULL, 'n'), ('NOTAREALTICKERX', 'x'), ('AAPL', 'z')) t(sym, note),
     LATERAL yf.quote(t.sym) q;
----
3	a=AAPL,m=MSFT,z=AAPL

# A comma list in one outer row fans out to several rows for that row.
query T
SELECT string_agg(q.symbol, ',' ORDER BY q.symbol)
FROM (VALUES ('AAPL,MSFT')) t(syms), LATERAL yf.quote(t.syms) q;
----
AAPL,MSFT
